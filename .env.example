# --- Database (matches the docker-compose postgres service) ---
DATABASE_URL=postgresql://toddle:toddle@localhost:5432/toddle_compose
# Separate write-heavy RTC persistence DB (@app/rtc-database; rtc-server uses this).
# Created automatically by docker/postgres-init on first `docker compose up`.
RTC_DATABASE_URL=postgresql://toddle:toddle@localhost:5432/toddle_compose_rtc

# --- Secrets (REQUIRED in every environment; no insecure defaults) ---
INTERNAL_TOKEN=dev-internal-secret-change-me
# Signs access JWTs. REQUIRED, min 32 chars. Generate: openssl rand -hex 32
JWT_USER_SECRET=change-me-min-32-chars-use-openssl-rand-hex-32

# --- Realm (this backend instance is pinned to exactly one realm) ---
# REQUIRED. Backend boots only if a realm row with this id exists (run the seed).
REALM_ID=realm_toddle
# Seed-only: the static realm owner provisioned by the seed script.
REALM_NAME=Toddle
REALM_OWNER_EMAIL=owner@toddle.test
REALM_OWNER_PASSWORD=password123
REALM_OWNER_NAME="Realm Owner"

# --- Auth tokens ---
ACCESS_TOKEN_TTL_SEC=900     # short-lived access JWT (15 min)
REFRESH_TOKEN_TTL_SEC=86400  # rotating refresh token (24 h)

# --- CORS (comma-separated allowlist; NO wildcard in prod) ---
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting (backend @nestjs/throttler; per client IP) ---
RATE_LIMIT_TTL_MS=60000          # window all limits below are measured over
RATE_LIMIT_GLOBAL_LIMIT=100      # default cap for throttler-guarded routes
RATE_LIMIT_AUTH_REGISTER=5       # POST /auth/register
RATE_LIMIT_AUTH_LOGIN=10         # POST /auth/login
RATE_LIMIT_AUTH_REFRESH=60       # POST /auth/refresh

# --- Rate limiting (rtc-server inbound WS messages; per connection token bucket) ---
RTC_RATE_LIMIT_CAPACITY=500          # bucket size (burst)
RTC_RATE_LIMIT_REFILL_PER_SEC=100    # steady refill rate

# --- Ports ---
BACKEND_PORT=4000
RTC_PORT=4001
RTC_INTERNAL_PORT=4002

# --- RTC token / JWKS ---
RTC_TOKEN_TTL_SEC=3600
RTC_PRIVATE_KEY_PATH=./.keys/rtc-private.pem
RTC_PUBLIC_KEY_PATH=./.keys/rtc-public.pem
RTC_TOKEN_ISS=toddlecompose-backend
RTC_TOKEN_AUD=rtc-server
RTC_INTERNAL_URL=http://localhost:4002
JWKS_URL=http://localhost:4000/.well-known/rtc-jwks.json

# --- RTC persistence / compaction tuning ---
RTC_DEBOUNCE_IDLE_MS=2000
RTC_DEBOUNCE_MAX_MS=10000
RTC_CHECKPOINT_INTERVAL_MS=300000
RTC_COMPACT_INTERVAL_MS=3600000
RTC_TIER1_AGE_MS=604800000
RTC_TIER2_AGE_MS=2592000000
RTC_SESSION_GAP_MS=30000

# --- Logging ---
LOG_LEVEL=debug

# --- Frontend (Vite) ---
VITE_BACKEND_URL=http://localhost:4000
VITE_RTC_WS_URL=ws://localhost:4001/yjs

# --- Object storage ---
BACKEND_PUBLIC_URL=http://localhost:4000
STORAGE_DRIVER=local            # local | s3
STORAGE_DIR=./.storage          # local driver: upload directory (gitignored)
STORAGE_MAX_UPLOAD_MB=25        # max accepted upload size (both drivers)

# S3 driver (only used when STORAGE_DRIVER=s3). First:
#   pnpm --filter backend add @aws-sdk/client-s3 @aws-sdk/s3-request-presigner
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT=          # set for MinIO / Cloudflare R2 (omit for AWS)
# STORAGE_S3_ACCESS_KEY_ID=     # omit to use the default AWS credential chain
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_PUBLIC_URL=        # public/CDN base; if unset, pre-signed GET URLs are issued
# STORAGE_S3_FORCE_PATH_STYLE=false   # true for MinIO
