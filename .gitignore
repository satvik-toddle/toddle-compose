# rtc-server bundled server nodes: the prebuilt bundle is COMMITTED so deploys
# (Render / CI) need no doc-editor checkout. Regenerate with `bundle:nodes` and
# recommit when the editor's nodes change. Everything else under vendor/ stays out.
# (Once doc-editor exports its nodes as a published subpath, repoint
#  rtc-server/package.json → docEditor.serverNodesEntry and drop the committed bundle.)
/rtc-server/vendor/*
!/rtc-server/vendor/server-nodes.cjs

# local object storage
.storage/
