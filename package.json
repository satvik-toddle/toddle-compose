{
  "name": "toddle-compose",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:services": "concurrently -n backend,rtc,frontend -c blue,magenta,green \"pnpm --filter backend dev\" \"pnpm --filter rtc-server dev\" \"pnpm --filter frontend dev\"",
    "dev:backend": "pnpm --filter backend dev",
    "dev:rtc": "pnpm --filter rtc-server dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @app/database generate && pnpm --filter @app/rtc-database generate",
    "db:migrate": "pnpm --filter @app/database migrate",
    "db:init": "set -a && . ./.env && set +a && pnpm --filter @app/database run init",
    "db:seed": "set -a && . ./.env && set +a && pnpm --filter @app/database run seed",
    "db:reset": "pnpm --filter @app/database reset",
    "db:push": "set -a && . ./.env && set +a && pnpm --filter @app/database exec prisma db push && pnpm --filter @app/rtc-database exec prisma db push",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "test": "set -a && . ./.env && set +a && pnpm --filter backend test:e2e",
    "release": "bash scripts/release.sh all",
    "staging:frontend": "bash scripts/release.sh frontend",
    "staging:backend": "bash scripts/release.sh backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  },
  "pnpm": {
    "comment": "Single-instance pins for the doc-editor (@toddle-edu/ds-doc-editor). Plain versions track its temp/lexical-yjs branch; bump in lockstep on editor upgrades. Add every @lexical/* subpackage you import. react/react-dom pinned to 18 for the new frontend (@toddle-edu/ds-* peer ranges allow ^18 and guarantee a single React instance). lexical/yjs/y-websocket stay pinned for rtc-server.",
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "lexical": "0.30.0",
      "@lexical/react": "0.30.0",
      "@lexical/yjs": "0.30.0",
      "@lexical/rich-text": "0.30.0",
      "@lexical/list": "0.30.0",
      "@lexical/code": "0.30.0",
      "@lexical/link": "0.30.0",
      "@lexical/utils": "0.30.0",
      "yjs": "13.6.27",
      "y-websocket": "2.0.4"
    },
    "patchedDependencies": {
      "@toddle-edu/ds-icons@1.21.1": "patches/@toddle-edu__ds-icons@1.21.1.patch"
    }
  }
}
