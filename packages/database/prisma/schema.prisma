generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  // Prisma 7 no longer allows `url` here. The connection string lives in
  // prisma.config.ts (for Migrate) and is passed via the @prisma/adapter-pg
  // driver adapter to the PrismaClient constructor (for the app runtime).
  provider = "postgresql"
}

enum Visibility {
  PRIVATE
  PUBLIC
}

// Document kind. DOC is the collaborative rich-text editor (default); SHEET is
// the collaborative data grid. Both share the same RTC/Yjs persistence, keyed
// by Document.id — only the client-side surface differs. Both kinds nest the
// same way (parentId DocumentTree below).
enum DocumentType {
  DOC
  SHEET
}

// Realm hierarchy (cumulative): OWNER > MAINTAINER > MEMBER.
// OWNER is the seeded static realm owner; MAINTAINER can create workspaces and
// run all realm/workspace operations; MEMBER belongs to the realm only.
enum RealmRole {
  OWNER
  MAINTAINER
  MEMBER
}

// Per-workspace role (cumulative): READ < COMMENT < EDIT < ADMIN.
// ADMIN can manage workspace members and create/edit pages.
enum WorkspaceRole {
  READ
  COMMENT
  EDIT
  ADMIN
}

// Lifecycle of a request to join a PRIVATE workspace or the org (realm).
enum JoinRequestState {
  PENDING
  APPROVED
  REJECTED
}

// Reach of a document share link: REALM → any logged-in realm member with the
// link; ANYONE → works logged-out, no auth at all.
enum ShareLinkScope {
  REALM
  ANYONE
}

model Realm {
  id         String        @id @default(cuid())
  name       String
  // Self-signup email allowlist (bare domains, e.g. "toddleapp.com"). Empty = any domain may register.
  allowedEmailDomains String[] @default([]) @map("allowed_email_domains")
  // When true, a signed-up non-member can request to join the org; admins approve in the console.
  joinRequestsEnabled Boolean  @default(false) @map("join_requests_enabled")
  createdAt  DateTime      @default(now()) @map("created_at")
  members    RealmMember[]
  workspaces Workspace[]
  orgJoinRequests OrgJoinRequest[]

  @@map("realms")
}

model RealmMember {
  realmId   String    @map("realm_id")
  realm     Realm     @relation(fields: [realmId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RealmRole @default(MEMBER)
  createdAt DateTime  @default(now()) @map("created_at")

  @@id([realmId, userId])
  @@index([userId])
  @@map("realm_members")
}

model Workspace {
  id        String            @id @default(cuid())
  realmId   String            @map("realm_id")
  realm     Realm             @relation(fields: [realmId], references: [id], onDelete: Cascade)
  name      String
  // PUBLIC → anyone in the realm self-joins as `defaultRole`; PRIVATE → request + approval.
  visibility  Visibility    @default(PRIVATE)
  defaultRole WorkspaceRole @default(READ) @map("default_role")
  createdAt DateTime          @default(now()) @map("created_at")
  members      WorkspaceMember[]
  joinRequests JoinRequest[]
  folders      Folder[]
  documents    Document[]

  @@index([realmId])
  @@map("workspaces")
}

model JoinRequest {
  id            String           @id @default(cuid())
  workspaceId   String           @map("workspace_id")
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String           @map("user_id")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  state         JoinRequestState @default(PENDING)
  requestedRole WorkspaceRole    @default(READ) @map("requested_role")
  decidedById   String?          @map("decided_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  decidedAt     DateTime?        @map("decided_at")

  @@index([workspaceId, state])
  @@index([userId])
  @@map("join_requests")
}

// Request to join the org (realm) directly, gated by Realm.joinRequestsEnabled.
// Mirrors JoinRequest; decidedById is an audit-only column with no relation.
model OrgJoinRequest {
  id          String           @id @default(cuid())
  realmId     String           @map("realm_id")
  realm       Realm            @relation(fields: [realmId], references: [id], onDelete: Cascade)
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  state       JoinRequestState @default(PENDING)
  decidedById String?          @map("decided_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  decidedAt   DateTime?        @map("decided_at")

  // One request row per user per realm; re-requesting flips the row back to PENDING.
  @@unique([realmId, userId])
  @@index([realmId, state])
  @@index([userId])
  @@map("org_join_requests")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(READ)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  color         String         @default("#f04c54")
  // Null until the user clicks the link in their sign-up verification email.
  // Login is refused while this is null (the "user not authenticated" state).
  // Added as a nullable column with NO backfill: pre-existing/legacy users are
  // intentionally treated as unverified and must verify (or reset password) to
  // sign in. See migrations/20260624_add_email_verification.sql.
  emailVerifiedAt DateTime?    @map("email_verified_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  documents     Document[]
  folders       Folder[]
  refreshTokens RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  realmMemberships     RealmMember[]
  workspaceMemberships WorkspaceMember[]
  joinRequests         JoinRequest[]
  orgJoinRequests      OrgJoinRequest[]
  documentStars        DocumentStar[]
  documentPermissions  DocumentPermission[]

  @@map("users")
}

// Short-lived, single-use tokens emailed on sign-up to verify ownership of the
// address. Mirrors RefreshToken: only the sha256 hash is stored, never the raw
// token (which travels in the email link). Consumed on success; GC'd once stale.
model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash") // sha256 of the raw token; raw is never stored
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at") // set when the link is successfully used
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

// Short-lived, single-use tokens emailed for "forgot password". Same shape as
// EmailVerificationToken: only the sha256 hash is stored; consumed on a
// successful reset and GC'd once stale.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash") // sha256 of the raw token; raw is never stored
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at") // set when the link is successfully used
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") // sha256 of the raw token; raw is never stored
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at") // set on rotation / logout
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Folder {
  id          String    @id @default(cuid())
  name        String
  icon        String?
  isPersonal  Boolean   @default(false) @map("is_personal")
  // Owning workspace — read access is granted to anyone with READ on it
  // (workspace members + the realm OWNER/MAINTAINER → ADMIN overlay).
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Creator of the folder; used for owner-level write rules.
  ownerId     String     @map("owner_id")
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentId    String?    @map("parent_id")
  parent      Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]   @relation("FolderTree")
  documents   Document[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  // Soft delete: set on delete, hidden from all reads, hard-purged after ~30 days.
  deletedAt   DateTime?  @map("deleted_at")

  @@index([ownerId])
  @@index([parentId])
  @@index([workspaceId])
  @@index([deletedAt])
  @@map("folders")
}

model Document {
  id          String     @id @default(cuid())
  title       String     @default("Untitled")
  icon        String?
  type        DocumentType @default(DOC)
  // Owning workspace — read access follows workspace READ (members + realm overlay).
  workspaceId String     @map("workspace_id")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Creator; used for owner-level write rules.
  ownerId     String       @map("owner_id")
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folderId    String?      @map("folder_id")
  folder      Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // Nesting: a document may live inside another document (a "subdoc"). The tree is
  // workspace-scoped (enforced in the service). Deleting a parent cascade-deletes its
  // subtree; the service collects descendant ids first to clean up their RTC rows.
  parentId    String?      @map("parent_id")
  parent      Document?    @relation("DocumentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Document[]   @relation("DocumentTree")
  // Per-user stars (favorites) on this doc; deleting the doc removes them (cascade).
  stars       DocumentStar[]
  // Per-page permission grants on this doc; deleting the doc removes them (cascade).
  permissions DocumentPermission[]
  // At most one live share link per doc (cascade on doc delete).
  shareLink   DocumentShareLink?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  // Collaborative content (yjsState / update log) lives in the SEPARATE
  // @app/rtc-database, keyed by this id. No FK relation here by design.
  // Denormalized plain-text projection of the doc body, pushed by rtc-server on each
  // snapshot flush. Lets content search run as ONE indexed query here (with the access
  // filter) instead of shipping doc ids to rtc — search never touches the collab server.
  // Backed by a pg_trgm GIN index (see migrations/…_search_content_trgm; not expressible
  // in Prisma schema). Null until the first flush after this shipped.
  contentText String?    @map("content_text")
  // Monotonic seq (rtc snapshot seq) of the content_text projection — guards against a
  // delayed/out-of-order index push overwriting newer text with older (see search-indexing.md G3).
  contentSeq  Int?       @map("content_seq")

  @@index([ownerId])
  @@index([folderId])
  @@index([parentId])
  @@index([workspaceId])
  // Backs the documents list (filtered by workspace, ordered by updatedAt desc).
  @@index([workspaceId, updatedAt])
  @@map("documents")
}

// A user's star ("favorite") on a document. Join table: one row = this user has
// starred this document. The composite primary key [userId, documentId] makes
// starring idempotent — a user can star a given doc at most once. Cascades on
// both sides, so deleting the user or the document drops the star automatically.
// Mirrors the WorkspaceMember/RealmMember join-table shape used elsewhere.
model DocumentStar {
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  // PK indexes userId-first, so "this user's stars" (the starred list) is covered;
  // the extra index backs lookups/cascades by document.
  @@id([userId, documentId])
  @@index([documentId])
  @@map("document_stars")
}

// A per-page (per-document) permission grant: one row = this user holds `role`
// on this specific document, independent of workspace membership. The grant does
// NOT cascade to sub-pages (lookups are by exact documentId). The role reuses the
// WorkspaceRole enum (any of READ/COMMENT/EDIT/ADMIN may be granted). Effective
// doc role = MAX(workspace-derived role, grant) — a grant only ever elevates.
// Composite PK [userId, documentId] makes a grant idempotent per (user, doc).
// Cascades on both sides, so deleting the user or the document drops the grant.
// Mirrors the DocumentStar/WorkspaceMember join-table shape used elsewhere.
model DocumentPermission {
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String        @map("document_id")
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role       WorkspaceRole @default(EDIT)
  createdAt  DateTime      @default(now()) @map("created_at")

  @@id([userId, documentId])
  @@index([documentId])
  @@map("document_permissions")
}

// "Anyone with the link" sharing: at most one live link per document (documentId
// is unique). The token is a crypto-random capability — knowing it (plus, for
// REALM scope, being a logged-in realm member) grants `role` on this one doc.
// Role is capped at EDIT (never ADMIN), enforced at the DTO layer. Regenerating
// replaces the token, instantly invalidating the old URL. createdById is a plain
// audit field (no relation), mirroring JoinRequest.decidedById.
model DocumentShareLink {
  id          String         @id @default(cuid())
  documentId  String         @unique @map("document_id")
  document    Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  token       String         @unique
  role        WorkspaceRole  @default(READ)
  scope       ShareLinkScope @default(REALM)
  createdById String         @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@map("document_share_links")
}
