// RTC persistence database — kept SEPARATE from the app database because the
// update log is write-heavy (one row per debounced edit) and should not contend
// with transactional auth/workspace queries. No FK to the app's Document model
// exists here (cross-database FKs aren't possible); `RtcDocument.id` simply holds
// the Document id minted by the backend. Cleanup of orphans is the backend's job
// (internal delete API / reconciliation), not a cascade.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  // Prisma 7 no longer allows `url` here. The connection string lives in
  // prisma.config.ts (for Migrate) and is passed via the @prisma/adapter-pg
  // driver adapter to the PrismaClient constructor (for the app runtime).
  provider = "postgresql"
}

model RtcDocument {
  id            String  @id
  // The CRDT source of truth: the encoded Yjs document. ALL content (DOC lexical
  // tree or SHEET grid) lives here. History/preview re-derive by replaying the
  // update log against this snapshot.
  yjsState      Bytes?  @map("yjs_state")
  // Plain-text projection of the doc content, refreshed on each snapshot write.
  // Read by content search (contentText contains q); redundant with yjsState by
  // design so search need not decode CRDT state. Null until first extraction.
  contentText   String? @map("content_text")
  version       Int     @default(0)
  updatedAt     BigInt  @map("updated_at")
  snapshotAtSeq Int     @default(0) @map("snapshot_at_seq")

  @@map("rtc_documents")
}

model RtcDocumentUpdate {
  id         BigInt  @id @default(autoincrement())
  docId      String  @map("doc_id")
  seq        Int
  updateBlob Bytes   @map("update_blob")
  byteLen    Int     @map("byte_len")
  origin     String?
  clientSub  String? @map("client_sub")
  createdAt  BigInt  @map("created_at")

  @@unique([docId, seq])
  @@index([docId, seq])
  @@map("rtc_document_updates")
}
