{
  "name": "rtc-server",
  "version": "0.1.0",
  "private": true,
  "docEditor": {
    "comment": "Entry for bundle:nodes (scripts/bundle-server-nodes.mjs). Relative paths resolve against this package dir; default assumes the toddle-edu/doc-editor repo is cloned as a sibling of toddle-compose on its temp/lexical-yjs branch (see setup.md). Override per-machine with RTC_SERVER_NODES_ENTRY. Repoint at the published @toddle-edu/ds-doc-editor package once these changes ship.",
    "serverNodesEntry": "../../doc-editor/packages/doc-editor/src/nodes/AllNodesServer.js"
  },
  "scripts": {
    "bundle:nodes": "node scripts/bundle-server-nodes.mjs",
    "dev": "nest start --watch",
    "build": "nest build",
    "db:deploy": "pnpm --filter @app/rtc-database exec prisma db push --skip-generate",
    "start": "pnpm run db:deploy && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@app/rtc-database": "workspace:*",
    "@lexical/code": "0.30.0",
    "@lexical/hashtag": "0.30.0",
    "@lexical/headless": "0.30.0",
    "@lexical/html": "0.30.0",
    "@lexical/link": "0.30.0",
    "@lexical/list": "0.30.0",
    "@lexical/overflow": "0.30.0",
    "@lexical/rich-text": "0.30.0",
    "@lexical/table": "0.30.0",
    "@lexical/utils": "0.30.0",
    "@lexical/yjs": "0.30.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^5.9.6",
    "lexical": "0.30.0",
    "lib0": "0.2.117",
    "linkedom": "^0.18.5",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "y-websocket": "2.0.4",
    "yjs": "^13.6.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.4",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.21.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.0"
  }
}
